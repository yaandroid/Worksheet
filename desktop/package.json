{
  "name": "brahm-office-desktop",
  "version": "1.1.0",
  "description": "BRAHM Office — all-in-one PDF, Excel & Word app (desktop). Brahm InnerBrain Technologies Pvt. Ltd.",
  "author": "Brahm InnerBrain Technologies Pvt. Ltd. (Developed by Sandeep Kushwah)",
  "main": "main.js",
  "scripts": {
    "prebuild": "node copy-webapp.js",
    "dist": "node copy-webapp.js && electron-builder",
    "dist:win": "node copy-webapp.js && electron-builder --win",
    "dist:mac": "node copy-webapp.js && electron-builder --mac",
    "dist:linux": "node copy-webapp.js && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "32.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.brahm.office",
    "productName": "BRAHM Office",
    "copyright": "© Brahm InnerBrain Technologies Pvt. Ltd.",
    "directories": { "output": "dist" },
    "files": [ "main.js", "preload.js", "webapp/**/*", "build/icon.*" ],
    "win": {
      "target": [ "portable", "nsis" ],
      "icon": "build/icon.png",
      "artifactName": "BRAHM-Office-${version}-${arch}.${ext}"
    },
    "portable": { "artifactName": "BRAHM-Office-${version}-portable.exe" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "mac": {
      "target": [ { "target": "dmg", "arch": [ "arm64", "x64" ] } ],
      "icon": "build/icon.png",
      "identity": null,
      "category": "public.app-category.productivity",
      "artifactName": "BRAHM-Office-${version}-${arch}.${ext}"
    },
    "dmg": { "writeUpdateInfo": false },
    "linux": {
      "target": [ "AppImage" ],
      "icon": "build/icon.png",
      "category": "Office",
      "artifactName": "BRAHM-Office-${version}.${ext}"
    }
  }
}
