<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#000000">

    <!-- Top bar: Cancel | resolution | Save -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="10dp" android:paddingBottom="8dp">
        <Button android:id="@+id/btnCancel" android:layout_width="wrap_content" android:layout_height="40dp"
            android:text="Cancel" android:textColor="#FFFFFF" android:textAllCaps="false"
            android:background="#2A2A2E" android:paddingLeft="18dp" android:paddingRight="18dp"/>
        <Spinner android:id="@+id/spRes" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:gravity="center"/>
        <Button android:id="@+id/btnSaveTop" android:layout_width="wrap_content" android:layout_height="40dp"
            android:text="Save" android:textColor="#1A1300" android:textStyle="bold" android:textAllCaps="false"
            android:backgroundTint="#FFC400" android:paddingLeft="22dp" android:paddingRight="22dp"/>
    </LinearLayout>

    <!-- Preview -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#000">
        <androidx.media3.ui.PlayerView android:id="@+id/pv"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:use_controller="false" app:resize_mode="fit" app:surface_type="texture_view"/>
        <com.brahm.autoeditor.PreviewOverlayView android:id="@+id/ov"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
    </FrameLayout>

    <!-- Transport: time · play · undo/redo -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="4dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/tvTime" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="00:00" android:textColor="#C9CEDC" android:textSize="13sp"/>
        <Button android:id="@+id/btnPlay" android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="▶" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@android:color/transparent"/>
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
        <Button android:id="@+id/btnUndo" android:layout_width="44dp" android:layout_height="44dp"
            android:text="↶" android:textColor="#C9CEDC" android:textSize="20sp" android:background="@android:color/transparent"/>
        <Button android:id="@+id/btnRedo" android:layout_width="44dp" android:layout_height="44dp"
            android:text="↷" android:textColor="#C9CEDC" android:textSize="20sp" android:background="@android:color/transparent"/>
    </LinearLayout>

    <!-- Contextual clip toolbar: Split | Replace | Delete | Crop | Change speed | Sort -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:background="#121214">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <Button android:id="@+id/btnSplit" style="@style/CapTool" android:text="⧈\nSplit"/>
            <Button android:id="@+id/btnReplace" style="@style/CapTool" android:text="⤵\nReplace"/>
            <Button android:id="@+id/btnDelete" style="@style/CapTool" android:text="🗑\nDelete"/>
            <Button android:id="@+id/btnCrop" style="@style/CapTool" android:text="⛶\nCrop"/>
            <Button android:id="@+id/btnSpeed" style="@style/CapTool" android:text="⏱\nSpeed"/>
            <Button android:id="@+id/btnSort" style="@style/CapTool" android:text="↕\nSort"/>
            <Button android:id="@+id/btnMute" style="@style/CapTool" android:text="🔊\nSound"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Clip strip controls -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp">
        <Button android:id="@+id/btnOrigSound" style="@style/CapChip" android:text="🔊 Original sound"/>
        <Button android:id="@+id/btnSetCover" style="@style/CapChip" android:text="🖼 Set cover"/>
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
        <Button android:id="@+id/btnZoomOut" style="@style/CapChip" android:text="➖"/>
        <Button android:id="@+id/btnZoomIn" style="@style/CapChip" android:text="➕"/>
        <Button android:id="@+id/btnAdd" style="@style/CapChip" android:text="➕ Add"/>
    </LinearLayout>

    <!-- Multi-track timeline (video thumbnails, captions, b-roll, music) -->
    <com.brahm.autoeditor.TimelineView android:id="@+id/tl"
        android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="2dp"/>

    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#9AA6CC" android:text=""
        android:paddingLeft="14dp" android:textSize="12sp"/>

    <!-- Bottom main toolbar: Trim | Music | Text | Adjust | Filter | Frame -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#121214" android:paddingTop="6dp" android:paddingBottom="8dp">
        <Button android:id="@+id/btnTTrim" style="@style/CapMain" android:text="✂\nTrim"/>
        <Button android:id="@+id/btnTAudio" style="@style/CapMain" android:text="🎵\nMusic"/>
        <Button android:id="@+id/btnTText" style="@style/CapMain" android:text="🅣\nText"/>
        <Button android:id="@+id/btnTAdjust" style="@style/CapMain" android:text="🎚\nAdjust"/>
        <Button android:id="@+id/btnTFilter" style="@style/CapMain" android:text="🎞\nFilter"/>
        <Button android:id="@+id/btnTFrame" style="@style/CapMain" android:text="🖼\nFrame"/>
    </LinearLayout>

    <Button android:id="@+id/btnShare" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="⬇️ Share / Save MP4"
        android:backgroundTint="#2A2A2E" android:textColor="#FFFFFF" android:textAllCaps="false" android:enabled="false"/>
</LinearLayout>
