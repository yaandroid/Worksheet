<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0B1020" android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Editor" android:textColor="#FFC400" android:textSize="18sp" android:textStyle="bold"/>
        <Button android:id="@+id/btnUndo" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↶" android:textColor="#EEF2FF" android:textSize="20sp"/>
        <Button android:id="@+id/btnRedo" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↷" android:textColor="#EEF2FF" android:textSize="20sp"/>
        <Spinner android:id="@+id/spRes" android:layout_width="110dp" android:layout_height="wrap_content"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="300dp"
        android:layout_marginTop="6dp" android:background="#000">
        <VideoView android:id="@+id/vv" android:layout_width="match_parent"
            android:layout_height="match_parent" android:layout_gravity="center"/>
        <com.brahm.autoeditor.PreviewOverlayView android:id="@+id/ov"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
    </FrameLayout>

    <com.brahm.autoeditor.TimelineView android:id="@+id/tl"
        android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="8dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="6dp">
        <Button android:id="@+id/btnPlay" android:layout_width="0dp" android:layout_weight="1.4"
            android:layout_height="wrap_content" android:text="▶ Play"/>
        <Button android:id="@+id/btnAddVid" android:layout_width="0dp" android:layout_weight="1.3"
            android:layout_height="wrap_content" android:text="➕🎬"/>
        <Button android:id="@+id/btnAddImg" android:layout_width="0dp" android:layout_weight="1.3"
            android:layout_height="wrap_content" android:text="➕🖼"/>
        <Button android:id="@+id/btnZoomOut" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="➖"/>
        <Button android:id="@+id/btnZoomIn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="➕"/>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnTTrim" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✂ Trim" android:textColor="#EEF2FF"/>
            <Button android:id="@+id/btnTAudio" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎵 Music" android:textColor="#EEF2FF"/>
            <Button android:id="@+id/btnTText" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🅣 Text" android:textColor="#EEF2FF"/>
            <Button android:id="@+id/btnTAdjust" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎚 Adjust" android:textColor="#EEF2FF"/>
            <Button android:id="@+id/btnTFilter" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎞 Filter" android:textColor="#EEF2FF"/>
            <Button android:id="@+id/btnTFrame" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🖼 Frame" android:textColor="#EEF2FF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <Button android:id="@+id/btnExport" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="💾 Save (export MP4)" android:backgroundTint="#FFC400" android:textColor="#1A1300"/>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#9AA6CC" android:text=""/>
    <Button android:id="@+id/btnShare" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="⬇️ Share / Save MP4" android:enabled="false"/>
</LinearLayout>
