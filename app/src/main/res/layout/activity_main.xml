<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/brahm_navy"
        app:title="BRAHM Office"
        app:titleTextColor="@color/white" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        app:boxBackgroundColor="@color/white"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint"
            android:textColor="@color/text_light"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <GridLayout
        android:id="@+id/gridTiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/sectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="2dp"
        android:text="@string/tab_recent"
        android:textStyle="bold"
        android:textColor="@color/text_light"
        android:textSize="15sp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:tabTextColor="@color/text_muted_light"
        app:tabSelectedTextColor="@color/brahm_navy"
        app:tabIndicatorColor="@color/brahm_saffron"
        app:tabMode="fixed"
        app:tabGravity="fill">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/tab_recent" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/tab_all" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/tab_tools" />
    </com.google.android.material.tabs.TabLayout>

    <LinearLayout
        android:id="@+id/selbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brahm_navy"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/selCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 selected"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />
        <Button
            android:id="@+id/selShare"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share"
            android:textColor="@color/brahm_saffron"
            android:textStyle="bold" />
        <Button
            android:id="@+id/selCancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="@color/white" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_light">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="24dp"
                android:gravity="center"
                android:text="@string/no_files"
                android:textColor="@color/text_muted_light"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:background="@color/brahm_navy"
        android:text="@string/developed_by"
        android:textColor="@color/text_muted_light"
        android:textSize="11sp" />
</LinearLayout>
