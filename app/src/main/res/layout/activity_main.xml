<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B1020" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BRAHM Auto-Editor" android:textColor="#FFC400" android:textSize="24sp"
            android:textStyle="bold" android:paddingBottom="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Raw video daalo → AI edit → timeline me kaam karo" android:textColor="#9AA6CC"
            android:paddingBottom="20dp"/>

        <Button android:id="@+id/btnPick" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="📁 Raw video chuno"/>
        <TextView android:id="@+id/tvFile" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="koi file nahi" android:textColor="#9AA6CC" android:paddingBottom="14dp"/>

        <TextView style="@style/Lbl" android:text="Caption language"/>
        <Spinner android:id="@+id/spLang" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView style="@style/Lbl" android:text="Groq API key (AI captions — device par save)"/>
        <EditText android:id="@+id/etGroqKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="gsk_..." android:inputType="textPassword"
            android:textColor="#EEF2FF" android:textColorHint="#55608A"/>

        <TextView style="@style/Lbl" android:text="Ya transcript paste karo (bina AI)"/>
        <EditText android:id="@+id/etTranscript" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minLines="2" android:gravity="top"
            android:inputType="textMultiLine" android:textColor="#EEF2FF"/>

        <Button android:id="@+id/btnCreate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="✨ Create project" android:backgroundTint="#FFC400" android:textColor="#1A1300"/>
        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#9AA6CC" android:paddingTop="8dp" android:text=""/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="24dp" android:textColor="#55608A" android:textSize="11sp"
            android:text="Editor me: timeline par caption/b-roll/music, tap karke edit, drag/trim, neeche toolbar (Text/Audio/B-roll/Theme/BG/FX), live preview, Export.\nBrahm InnerBrain Technologies · Developed by Sandeep Kushwah"/>
    </LinearLayout>
</ScrollView>
